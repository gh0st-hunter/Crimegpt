	EVIDENCE -> CHARGESHEET [label="Evidence\ncomplete"]
	CHARGESHEET -> COURT [label="Court hearings\nbegin"]
	COURT -> CLOSED [label="Judgment\ndelivered"]
	FILED -> CLOSED [label="Case dismissed"]
	UNDER_INV -> CLOSED [label="Investigation\ncomplete"]
	CLOSED -> REOPENED [label="New evidence\nor appeal"]
	REOPENED -> UNDER_INV [label="Re-investigate"]

