// FLOWCHART 2: AUTHENTICATION & AUTHORIZATION FLOW
// ═══════════════════════════════════════════════════════════════════

digraph AuthFlow {
	label="FLOWCHART 2: Authentication & Authorization Flow"
	labelloc=t
	fontname="Helvetica"
	fontsize=20
	rankdir=TB
	node [shape=box style="rounded,filled" fontname="Helvetica" fontsize=11 fillcolor="#e8f0fe"]
	edge [fontname="Helvetica" fontsize=9]

	START [label="User Opens App" shape=ellipse fillcolor="#d4edda"]

	CHECK [label="Token in\nlocalStorage?" shape=diamond fillcolor="#fff3cd"]

	VERIFY [label="GET /api/auth/me\nVerify JWT Token"]
	VALID [label="Token Valid\nLoad User Data"]
	INVALID [label="Token Invalid\nor Expired"]
	CLEAR [label="Clear localStorage\n(token + user)"]

	LOGIN_PAGE [label="Show Login /\nRegister Page"]

	REG_OR_LOGIN [label="Register\nor Login?" shape=diamond fillcolor="#fff3cd"]

	// Register path
	REGISTER [label="POST /api/auth/register\nemail, password, full_name,\nrole, badge_number, station, rank"]
	HASH [label="Hash Password\n(bcrypt)"]
	CREATE_USER [label="Create User in DB\n(auto-verified for demo)"]

	// Login path
	LOGIN [label="POST /api/auth/login\nemail, password"]
	VALIDATE [label="Validate Credentials\n(bcrypt verify)"]
	CHECK_ACTIVE [label="Account\nActive?" shape=diamond fillcolor="#fff3cd"]

	// Outcomes
	GEN_TOKEN [label="Generate JWT Token\n(HS256, 30-day expiry)\npayload: user_id + role"]
	STORE [label="Store in localStorage\n• crimegpt_token\n• crimegpt_user"]
	DASHBOARD [label="Load Dashboard" shape=ellipse fillcolor="#d4edda"]
	ERROR_401 [label="401\nInvalid Credentials" shape=ellipse fillcolor="#f8d7da"]
	ERROR_403 [label="403\nAccount Deactivated" shape=ellipse fillcolor="#f8d7da"]

	// RBAC
	RBAC [label="Role-Based Access Control" shape=note fillcolor="#e8e0f0"]
	VICTIM [label="VICTIM\nOwn cases only"]
	OFFICER [label="OFFICER\nAssigned + unassigned cases"]
	ADMIN [label="ADMIN\nFull access to all"]

	// Edges
	START -> CHECK
	CHECK -> VERIFY [label="Yes"]
	CHECK -> LOGIN_PAGE [label="No"]

	VERIFY -> VALID [label="200 OK"]
	VERIFY -> INVALID [label="401 Error"]
	VALID -> DASHBOARD
	INVALID -> CLEAR
	CLEAR -> LOGIN_PAGE

	LOGIN_PAGE -> REG_OR_LOGIN

	REG_OR_LOGIN -> REGISTER [label="Register"]
	REG_OR_LOGIN -> LOGIN [label="Login"]

	REGISTER -> HASH
	HASH -> CREATE_USER
	CREATE_USER -> GEN_TOKEN

	LOGIN -> VALIDATE
	VALIDATE -> CHECK_ACTIVE [label="Credentials OK"]
	VALIDATE -> ERROR_401 [label="Wrong email/password"]
	CHECK_ACTIVE -> GEN_TOKEN [label="Yes"]
	CHECK_ACTIVE -> ERROR_403 [label="No"]

	GEN_TOKEN -> STORE
	STORE -> DASHBOARD

	DASHBOARD -> RBAC
	RBAC -> VICTIM
	RBAC -> OFFICER
	RBAC -> ADMIN
}


